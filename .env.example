# Find this value with: tailscale ip -4
TAILSCALE_IP=100.122.30.29
API_PORT=3333

# PostgreSQL is the source of truth for parsed papers and also hosts BullMQ's
# isolated `bullmq` schema. The database is only exposed to Compose services.
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=research-dev
DATABASE_URL=postgresql+psycopg://research:research-dev@postgres:5432/research

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
# Low-cost first-pass model used for discovery and candidate verification.
CLAIM_AUDIT_MODEL=gpt-5.4-nano
# Stronger fallback for heuristic candidates the first pass does not publish.
CLAIM_AUDIT_REVIEW_MODEL=gpt-5.4-mini

# Optional. Puts OpenAlex requests on the polite pool.
OPENALEX_MAILTO=

# Optional. OpenAlex API key. Keep this in .env, never commit it.
OPENALEX_API_KEY=

# Optional. Your own HTTP(S) proxy, e.g. http://127.0.0.1:8888
OPENALEX_PROXY=

# Legacy JSONL imported idempotently into PostgreSQL at worker startup.
OPENALEX_CACHE_PATH=/data/openalex-cache.jsonl

# Docker Compose starts MinIO locally. Leave S3_ENDPOINT empty only when running
# the API directly and intentionally using the filesystem adapter. Railway uses
# private service-variable references instead of these development credentials.
MINIO_ROOT_USER=research
MINIO_ROOT_PASSWORD=research-minio-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=research
S3_SECRET_KEY=research-minio-dev
S3_BUCKET=research-papers
S3_REGION=us-east-1
S3_SECURE=0

# Optional but recommended for higher Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_URL=https://api.semanticscholar.org/graph/v1
