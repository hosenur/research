# Find this value with: tailscale ip -4
TAILSCALE_IP=100.122.30.29
API_PORT=3333

# Optional. Puts OpenAlex requests on the polite pool.
OPENALEX_MAILTO=

# Optional. OpenAlex API key. Keep this in .env, never commit it.
OPENALEX_API_KEY=

# Optional. Your own HTTP(S) proxy, e.g. http://127.0.0.1:8888
OPENALEX_PROXY=

# File cache for OpenAlex responses. Redis can replace this later.
OPENALEX_CACHE_PATH=/data/openalex-cache.jsonl
